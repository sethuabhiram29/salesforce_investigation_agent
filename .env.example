# LLM Configuration (OpenAI or Local Ollama)
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL Knowledge Store (pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sf_investigation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_DSN=postgresql://postgres:postgres@localhost:5432/sf_investigation

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Salesforce MCP (Model Context Protocol) Connection
# URL for the Salesforce MCP Server (JSON-RPC / SSE endpoint)
SALESFORCE_MCP_URL=http://localhost:8000/mcp

# Salesforce Org Credentials (for direct auth or MCP server configuration)
SALESFORCE_INSTANCE_URL=https://mycompany.my.salesforce.com
SALESFORCE_USERNAME=admin.integration@mycompany.com
SALESFORCE_PASSWORD=MySecurePassword123!
SALESFORCE_SECURITY_TOKEN=OptionalSecurityTokenXYZ
SALESFORCE_CLIENT_ID=3MVG9...
SALESFORCE_CLIENT_SECRET=...
SALESFORCE_ACCESS_TOKEN=fixture

# ServiceNow (Incident Intake & Closure)
SERVICENOW_INSTANCE=https://dev.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=admin
